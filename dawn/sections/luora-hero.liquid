{% comment %}
  Luora v2 homepage hero — full-bleed photography with the headline overlaid
  on top, in the register of ROUND LAB's homepage hero. One headline, one
  line, one CTA, one small proof line, all sitting over the photo instead of
  beside it. Ref: luora-website-redesign-concept-v2.md §03 (superseded here
  on layout only — the monochrome/typography rules still apply to the text).
{% endcomment %}
<section
  class="luora-hero luora-hero--{{ section.settings.image_height }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.image != blank %} luora-hero--has-image{% endif %}"
>
  {%- if section.settings.image != blank -%}
    <div
      class="luora-hero__media"
      style="--luora-hero-overlay: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }}; --luora-hero-position: {{ section.settings.image_position }};"
    >
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', class: 'luora-hero__image'
      }}
    </div>
  {%- endif -%}

  <div
    class="luora-hero__inner page-width luora-hero__inner--{{ section.settings.desktop_content_position }} luora-hero__inner--{{ section.settings.desktop_content_alignment }}"
  >
    <div class="luora-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="luora-eyebrow luora-label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="luora-hero__heading h1">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="luora-hero__subheading luora-body">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button luora-hero__cta">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.proof_line != blank -%}
        <p class="luora-hero__proof luora-label">{{ section.settings.proof_line | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .luora-hero {
    position: relative;
    display: flex;
    overflow: hidden;
  }

  .luora-hero:not(.luora-hero--has-image) {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 100px);
  }

  .luora-hero--has-image {
    min-height: 60svh;
  }

  .luora-hero--small.luora-hero--has-image {
    min-height: 50svh;
  }

  .luora-hero--medium.luora-hero--has-image {
    min-height: 70svh;
  }

  .luora-hero--large.luora-hero--has-image {
    min-height: 85svh;
  }

  .luora-hero--full.luora-hero--has-image {
    min-height: 100svh;
  }

  .luora-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .luora-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(0, 0, 0, var(--luora-hero-overlay, 0.35)) 0%,
      rgba(0, 0, 0, calc(var(--luora-hero-overlay, 0.35) * 0.55)) 35%,
      rgba(0, 0, 0, 0) 70%
    );
  }

  .luora-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--luora-hero-position, center) center;
  }

  .luora-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    width: 100%;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .luora-hero__inner--top {
    align-items: flex-start;
  }

  .luora-hero__inner--middle {
    align-items: center;
  }

  .luora-hero__inner--bottom {
    align-items: flex-end;
  }

  .luora-hero__inner--left {
    justify-content: flex-start;
    text-align: left;
  }

  .luora-hero__inner--center {
    justify-content: center;
    text-align: center;
  }

  .luora-hero__inner--right {
    justify-content: flex-end;
    text-align: right;
  }

  .luora-hero__copy {
    max-width: 46ch;
  }

  .luora-hero--has-image .luora-hero__copy {
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.2);
  }

  .luora-eyebrow {
    color: var(--luora-text-secondary, rgba(0, 0, 0, 0.55));
    margin-bottom: 1.8rem;
  }

  .luora-hero--has-image .luora-eyebrow {
    color: rgba(var(--color-foreground), 0.75);
  }

  .luora-hero__heading {
    margin: 0 0 2.2rem;
    max-width: 16ch;
  }

  .luora-hero__inner--center .luora-hero__heading {
    margin-left: auto;
    margin-right: auto;
  }

  .luora-hero__subheading {
    max-width: 46ch;
    color: var(--luora-text-secondary, rgba(0, 0, 0, 0.55));
    margin: 0 0 3rem;
  }

  .luora-hero--has-image .luora-hero__subheading {
    color: rgba(var(--color-foreground), 0.85);
  }

  .luora-hero__inner--center .luora-hero__subheading {
    margin-left: auto;
    margin-right: auto;
  }

  .luora-hero__cta {
    margin-bottom: 2.4rem;
  }

  .luora-hero__proof {
    color: var(--luora-text-secondary, rgba(0, 0, 0, 0.55));
    margin: 0;
    display: block;
  }

  .luora-hero--has-image .luora-hero__proof {
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (max-width: 749px) {
    .luora-hero--has-image {
      min-height: 42svh;
    }

    .luora-hero--small.luora-hero--has-image {
      min-height: 32svh;
    }

    .luora-hero--medium.luora-hero--has-image {
      min-height: 42svh;
    }

    .luora-hero--large.luora-hero--has-image {
      min-height: 55svh;
    }

    .luora-hero--full.luora-hero--has-image {
      min-height: 75svh;
    }

    .luora-hero__media::after {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, var(--luora-hero-overlay, 0.35)) 0%,
        rgba(0, 0, 0, calc(var(--luora-hero-overlay, 0.35) * 0.7)) 55%,
        rgba(0, 0, 0, calc(var(--luora-hero-overlay, 0.35) * 0.3)) 100%
      );
    }

    .luora-hero__inner--left,
    .luora-hero__inner--right {
      justify-content: flex-start;
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luora hero",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Controls text/button color. Use a dark scheme (e.g. scheme-4) for white text over a photo.",
      "default": "scheme-4"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wyselekcjonowana kolekcja"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Koreańska pielęgnacja. Bez kompromisów.</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wyselekcjonowana kolekcja produktów od marek, którym ufamy – bo sami ich używamy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Zobacz kolekcję"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "proof_line",
      "label": "Proof line",
      "info": "One small line, not a stat bar.",
      "default": "63 produkty · 13 marek · prosto z Korei"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Fills the full section, edge to edge. Leave blank for a plain color background."
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image overlay opacity",
      "info": "Darkens the image behind the text so it stays legible.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "Nudges which part of the image stays in frame when it's cropped to fit.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Desktop content position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "label": "Desktop content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Luora hero"
    }
  ]
}
{% endschema %}
