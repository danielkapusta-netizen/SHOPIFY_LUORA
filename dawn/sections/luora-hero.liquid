{% comment %}
  Luora v2 homepage hero — flat, typographic, on white. One headline, one
  line, one CTA, one small proof line folded underneath (not a standalone
  proof-strip section). Ref: luora-website-redesign-concept-v2.md §03.
{% endcomment %}
<section class="luora-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="luora-hero__inner page-width">
    <div class="luora-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="luora-eyebrow luora-label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="luora-hero__heading h1">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="luora-hero__subheading luora-body">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button luora-hero__cta">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.proof_line != blank -%}
        <p class="luora-hero__proof luora-label">{{ section.settings.proof_line | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="luora-hero__media">
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 45vw, 100vw'
        }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .luora-hero {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 100px);
  }

  .luora-hero__inner {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .luora-hero__inner:has(.luora-hero__media) {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .luora-eyebrow {
    color: var(--luora-text-secondary, rgba(0, 0, 0, 0.55));
    margin-bottom: 1.8rem;
  }

  .luora-hero__heading {
    margin: 0 0 2.2rem;
    max-width: 16ch;
  }

  .luora-hero__subheading {
    max-width: 46ch;
    color: var(--luora-text-secondary, rgba(0, 0, 0, 0.55));
    margin: 0 0 3rem;
  }

  .luora-hero__cta {
    margin-bottom: 2.4rem;
  }

  .luora-hero__proof {
    color: var(--luora-text-secondary, rgba(0, 0, 0, 0.55));
    margin: 0;
    display: block;
  }

  .luora-hero__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .luora-hero__inner:has(.luora-hero__media) {
      grid-template-columns: 1fr;
    }

    .luora-hero__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luora hero",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wyselekcjonowana kolekcja"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Koreańska pielęgnacja. Bez kompromisów.</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wyselekcjonowana kolekcja produktów od marek, którym ufamy — bo sami ich używamy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Zobacz kolekcję"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "proof_line",
      "label": "Proof line",
      "info": "One small line, not a stat bar.",
      "default": "63 produkty · 13 marek · źródła z Korei"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    }
  ],
  "presets": [
    {
      "name": "Luora hero"
    }
  ]
}
{% endschema %}
