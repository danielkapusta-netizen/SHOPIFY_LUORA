{% comment %}
  Luora — "Zestawy pielęgnacyjne" bundle.

  One section instance per routine, so bundles can be reordered and edited
  individually in the theme editor. Each `step` block is one stage of the
  routine (oczyszczanie → tonik → serum → krem → SPF) pointing at a real
  product; the section sums their prices and shows the routine's discount
  code. Products are bought individually — this is a curated display, not a
  bundle SKU.
{% endcomment %}

{%- liquid
  assign routine_total = 0
  for block in section.blocks
    if block.settings.product != blank
      assign routine_total = routine_total | plus: block.settings.product.price
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="luora-routine color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <header class="luora-routine__header">
      {%- if section.settings.concern_label != blank -%}
        <p class="luora-label luora-routine__eyebrow">{{ section.settings.concern_label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="luora-routine__heading h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="luora-routine__intro luora-body rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <ol class="luora-routine__steps" role="list">
      {%- for block in section.blocks -%}
        {%- assign step_product = block.settings.product -%}
        <li class="luora-routine__step" {{ block.shopify_attributes }}>
          <span class="luora-routine__step-index luora-label">{{ forloop.index }}</span>

          <div class="luora-routine__step-media">
            {%- if step_product != blank and step_product.featured_media != blank -%}
              <a href="{{ step_product.url }}" tabindex="-1" aria-hidden="true">
                {{
                  step_product.featured_media
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', sizes: '160px', alt: step_product.title
                }}
              </a>
            {%- else -%}
              <span class="luora-routine__step-placeholder" aria-hidden="true">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </span>
            {%- endif -%}
          </div>

          <div class="luora-routine__step-body">
            {%- if block.settings.step_label != blank -%}
              <p class="luora-label luora-routine__step-label">{{ block.settings.step_label | escape }}</p>
            {%- endif -%}

            {%- if step_product != blank -%}
              <h3 class="luora-routine__step-title">
                <a href="{{ step_product.url }}">{{ step_product.title | escape }}</a>
              </h3>
              <div class="luora-routine__step-price">
                {% render 'price', product: step_product %}
              </div>
              {%- unless step_product.available -%}
                <p class="luora-routine__step-soldout luora-label">
                  {{- 'products.product.sold_out' | t -}}
                </p>
              {%- endunless -%}
            {%- endif -%}

            {%- if block.settings.step_note != blank -%}
              <p class="luora-routine__step-note luora-body">{{ block.settings.step_note | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    <footer class="luora-routine__footer">
      {%- if routine_total > 0 -%}
        <p class="luora-routine__total">
          <span class="luora-label">{{ section.settings.total_label | escape }}</span>
          <span class="luora-routine__total-value">{{ routine_total | money }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.discount_code != blank -%}
        <p class="luora-routine__code">
          {{ section.settings.discount_text | escape }}
          <span class="luora-routine__code-value">{{ section.settings.discount_code | escape }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="luora-routine__note luora-body">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "Luora routine bundle",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "concern_label",
      "label": "Concern label (eyebrow)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Routine name"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Cały zestaw"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount text",
      "default": "Zamów cały zestaw z 10% rabatem – kod"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "info": "Optional caution, e.g. not to layer two acids the same evening."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "step_label",
          "label": "Step label",
          "info": "e.g. Oczyszczanie, Tonik, Serum, Krem, SPF"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "step_note",
          "label": "Step note"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luora routine bundle",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
